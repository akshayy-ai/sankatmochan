# Cloudflare tunnel + webhook registration.
#
# Read by docker-compose.yml, NOT by the app. Compose treats a missing env_file
# as fatal, so this file must exist as .env.tunnel before `docker compose up`.
#
#   cp .env.tunnel.example .env.tunnel

# Named-tunnel credential from the Cloudflare dashboard (Zero Trust > Networks >
# Tunnels). cloudflared reads this variable natively — do not pass it as a
# --token flag, because Compose interpolates command strings from .env at parse
# time and not from env_file, so the flag would expand to an empty value.
#
# A QUICK TUNNEL WILL NOT WORK HERE. Telegram refuses *.trycloudflare.com
# webhook targets, so this must be a named tunnel on a domain you control.
# Route it in the dashboard: Public Hostname -> http://app:3000
TUNNEL_TOKEN=

# The public hostname the tunnel serves, with scheme and no trailing slash.
# The registrar service re-points the Telegram webhook here on every start, so
# a redeploy or reboot never leaves the bot registered to a stale target.
# Left empty, the registrar logs a notice and exits cleanly, and the bot stays
# on whatever target it was last given.
PUBLIC_URL=https://your-hostname.example.com
