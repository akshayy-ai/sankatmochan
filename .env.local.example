#   cp .env.local.example .env.local
#
# Only OPENAI_API_KEY is needed to boot the console. Everything else turns on a
# channel or a feature, and the app degrades rather than crashing without most
# of them — the exceptions are called out below.

# ─── Required ────────────────────────────────────────────────────────────────

# Triage, translation, vision, transcription and the Realtime voice agent all
# run on this one key. Without it the core routes return 500.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# ─── Local development ───────────────────────────────────────────────────────

# Where the SQLite mirror lives. Defaults to /data/sankatmochan.db, which is
# correct inside the container and impossible on a dev machine — if the default
# is used locally, persistence permanently disables itself at startup and the
# app runs memory-only. Set a relative path for local work.
CASE_DB_PATH=./.data/sankatmochan.db

# ─── Channels — set the ones you want to run ─────────────────────────────────

# Telegram ingest and replies. Talk to @BotFather to create a bot.
TELEGRAM_BOT_TOKEN=

# Public origin, no trailing slash. Used to build Vobiz callback URLs and as the
# webhook target during registration. In Docker this is set for you.
PUBLIC_BASE_URL=https://your-hostname.example.com

# Guards the webhook-target override on /api/telegram/setup. Leave unset and the
# override is disabled entirely — the endpoint can then only ever re-register
# PUBLIC_BASE_URL, which is what makes it safe to expose. Set it only if you
# need to repoint the bot from outside the compose stack.
TELEGRAM_SETUP_SECRET=

# Inbound SMS via SMS Gateway for Android (https://sms-gate.app).
# Without USERNAME/PASSWORD inbound SMS still files cases and only the reply is
# skipped. SIGNING_KEY is security-relevant: with it unset, HMAC verification of
# inbound webhooks is skipped entirely and anyone can post a fake SMS.
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_SIGNING_KEY=

# Speech-recognition locale for the inbound phone IVR. Defaults to hi-IN.
VOBIZ_GATHER_LANGUAGE=hi-IN

# Browser-voice cases are flagged as DRILL unless this is set to a truthy value.
REALTIME_LIVE=

# ─── Integrations ────────────────────────────────────────────────────────────

# Dispatch tasks and autonomous SLA escalation. Without it, escalation silently
# no-ops — the breach is still recorded on the case.
# npx ambiguous auth signup --name "My Agent" --human-email you@example.com
AMBIGUOUS_API_KEY=
AMBIGUOUS_API_URL=https://api.ambiguous.ai

# Live disaster-news strip. NOTE: this one does not degrade — the news routes
# throw rather than returning empty, so leave it set or expect 500s there.
# https://dashboard.exa.ai
EXA_API_KEY=

# ─── CopilotKit runtime ──────────────────────────────────────────────────────

# Valid providers are openai, anthropic and google. "openrouter" is NOT a valid
# value — the runtime's resolveModel throws on it.
MODEL_PROVIDER=openai
MODEL=gpt-4o

# ─── Docker ──────────────────────────────────────────────────────────────────
# TUNNEL_TOKEN and PUBLIC_URL are read by Compose from a separate file.
# See .env.tunnel.example.
